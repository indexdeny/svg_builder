# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
venv/
.venv/
.ipynb_checkpoints/

# Project temporary processing and logs
02_processing/*
!02_processing/.gitkeep

ops/logs/*
!ops/logs/.gitkeep
!ops/logs/qa_failures.jsonl
!ops/logs/validation_errors.jsonl

05_output_svg/staging/*
!05_output_svg/staging/.gitkeep

05_output_svg/quarantine/*
!05_output_svg/quarantine/.gitkeep

# Input folder binary files (top-level and any subfolder, e.g. input/photos/)
input/*.png
input/*.jpg
input/*.jpeg
input/*.webp
input/**/*.png
input/**/*.jpg
input/**/*.jpeg
input/**/*.JPG
input/**/*.webp

# Raster working copies (regenerable from input/ by deconstruct.py)
01_input_raster/**/*.png
01_input_raster/**/*.jpg
01_input_raster/**/*.jpeg
01_input_raster/**/*.JPG
01_input_raster/**/*.webp

# Owner-authorized public dataset: exactly the two canonical source folders.
!01_input_raster/complex_gradients/**/*.png
!01_input_raster/complex_gradients/**/*.jpg
!01_input_raster/complex_gradients/**/*.jpeg
!01_input_raster/complex_gradients/**/*.webp
!01_input_raster/high_contrast/**/*.png
!01_input_raster/high_contrast/**/*.jpg
!01_input_raster/high_contrast/**/*.jpeg
!01_input_raster/high_contrast/**/*.webp

# QA preview / scratch renders
ops/qa_previews/

# 3MF binaries (regenerable from SVG; sidecar .json metadata stays tracked)
07_output_3mf/*.3mf
07_output_3mf/staging/
07_output_3mf/quarantine/*
!07_output_3mf/quarantine/.gitkeep
!07_output_3mf/quarantine/*.failure.json

# Released, provenance-verified meshes are published with their JSON sidecars.
!07_output_3mf/*.3mf
